# remap prefix from 'C-b' to 'C-a'
unbind C-b
set-option -g prefix C-s
bind-key C-s send-prefix

# setw -g mode-keys vi
set -g mouse on
set-option -g status-position top

set -as terminal-features ",xterm-256color:RGB"

# switch panes using VIM keybindings
bind h select-pane -L
bind l select-pane -R
bind k select-pane -U
bind j select-pane -D


# reload config file (change file location to your the tmux.conf you want to use)
unbind r
bind r source-file ~/.config/tmux/tmux.conf

# set -g terminal-overrides "xterm*:XT:smcup@:rmcup@:kUP5=\eOA:kDN5=\eOB:kLFT5=\eOD:kRIT5=\eOC"

# bind -T copy-mode-vi J send-keys -X scroll-down; send-keys -X scroll-down; send-keys -X scroll-down
# bind -T copy-mode-vi K send-keys -X scroll-up; send-keys -X scroll-up; send-keys -X scroll-up

# enable mouse functionality
# set -g mouse on

# List plugins
set -g @plugin 'tmux-plugins/tpm' # mandatory
set -g @plugin 'tmux-plugins/tmux-sensible' # optional recommended
set -g @plugin 'NHDaly/tmux-better-mouse-mode'
set -g @plugin 'christoomey/vim-tmux-navigator'

# Restore tmux sessions
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum' # Optional: for auto-save/restore

set -g @resurrect-strategy-nvim 'none'
set -g @resurrect-processes 'false'

############## CATPPUCCIN V2 ##############
# 1. Load the core theme configurations
set -g @plugin 'catppuccin/tmux#v2.1.2'
# set -g @catppuccin_flavor 'mocha'
set -g @catppuccin_flavor 'gruvbox'

# 2. Window (Tabs in center/left) - Force rounded pill design
set -g @catppuccin_window_status_style "rounded"
set -g @catppuccin_window_left_separator ""
set -g @catppuccin_window_right_separator " "
set -g @catppuccin_window_middle_separator " █"
set -g @catppuccin_window_number_position "right"

set -g @catppuccin_window_default_fill "number"
set -g @catppuccin_window_default_text "#W"

set -g @catppuccin_window_current_fill "number"
set -g @catppuccin_window_current_text "#W"

set -g @catppuccin_window_text "#W"

# 3. Global Status Bar Layout Tweaks
set -g @catppuccin_status_left_separator  " "
set -g @catppuccin_status_right_separator ""
set -g @catppuccin_status_fill "icon"
set -g @catppuccin_status_connect_separator "no"

# 4. Fix custom formatting for Modules
set -g @catppuccin_date_time_text " %H:%M"
set -g @catppuccin_directory_text "#{b:pane_current_path}"

# 5. CRITICAL V2 CHANGE: Wipe the host default bar and build right bar manually
# We must adjust lengths so things don't get truncated
set -g status-left-length 100
set -g status-right-length 100

# Clear default layout completely 
set -g status-left ""

# Explicitly assemble the modules you want on the right using the new evaluation token syntax #{E:...}
# This removes the ugly hostname text and forces Catppuccin styling engine into effect.
set -g status-right "#{E:@catppuccin_status_session}"
set -ag status-right "#{E:@catppuccin_status_date_time}"
############## /CATPPUCCIN V2 ##############


set -g @vim_navigator_mapping_left "C-h"  # use C-h and C-Left
set -g @vim_navigator_mapping_right "C-l"
set -g @vim_navigator_mapping_up "C-k"
set -g @vim_navigator_mapping_down "C-j"
set -g @vim_navigator_prefix_mapping_clear_screen ""
run '~/.config/tmux/plugins/tpm/tpm'

